# Kova AI Common Environment Variables Template
# Copy this to .env, supply unique secrets through a secret store, and validate before deployment.
# Blank credentials must fail setup; never use predictable sample passwords.

# API Keys (REQUIRED)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GITHUB_TOKEN=your_github_token_here
PINECONE_API_KEY=your-pinecone-key-here

# Database Configuration
POSTGRES_DB=kova
POSTGRES_USER=kova
POSTGRES_PASSWORD=
DATABASE_URL=

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Application Settings
APP_NAME=Kova AI
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Security
SECRET_KEY=
JWT_SECRET_KEY=
GITHUB_WEBHOOK_SECRET=

# Multi-Repo Settings
GITHUB_OWNER=Kathrynhiggs21
SYNC_INTERVAL_MINUTES=30
AUTO_DISCOVER_REPOS=false

# Claude Settings
CLAUDE_MODEL=claude-3-sonnet-20240229
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=1.0

# External Services
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_PASSWORD=

# Feature Flags
ENABLE_AUTO_FIX=false
ENABLE_CLAUDE_SYNC=false
ENABLE_WEBHOOKS=false
ENABLE_MULTI_REPO=false
