  ],
  "worlds": [
    {
      "name": "scribbles-by-marcy",
      "full_name": "Kathrynhiggs21/scribbles-by-marcy",
      "type": "world",
      "enabled": false,
      "relationship": "independent-domain-repository",
      "lifecycle": "review"
    },
    {
      "name": "Scribblesbymarcy",
      "full_name": "Kathrynhiggs21/Scribblesbymarcy",
      "type": "world",
      "enabled": false,
      "relationship": "duplicate-name-migration-candidate",
      "lifecycle": "unreviewed"
    },
    {
      "name": "Scribbles-Zoo-Project",
      "full_name": "Kathrynhiggs21/Scribbles-Zoo-Project",
      "type": "world",
      "enabled": false,
      "relationship": "independent-domain-repository",
      "lifecycle": "review",
      "exclusions": [
        "legacy-renderer"
      ]
    }
  ],
  "excluded_repositories": [
    {
      "full_name": "Kathrynhiggs21/mem0",
      "reason": "generic private placeholder; not a canonical KOVA component",
      "enabled": false
    },
    {
      "full_name": "Kovaos-com/vite-react",
      "reason": "unmodified framework starter; not a KOVA production application",
      "enabled": false
    },
    {
      "full_name": "Kathrynhiggs21/platforms-starter-kit",
      "reason": "generic platform starter retained only as a reference",
      "enabled": false
    }
  ],
  "sync_settings": {
    "auto_sync_enabled": false,
    "sync_interval_minutes": 30,
    "sync_on_push": false,
    "sync_on_pr": false,
    "cross_repo_notifications": false
  },
  "discovery_settings": {
    "auto_discover_new_repos": false,
    "repo_name_pattern": "kova-ai-",
    "watch_for_new_repos": false
  },
  "integration_settings": {
    "claude_api_enabled": false,
    "github_webhooks_enabled": false,
    "cross_repo_prs": false,
    "unified_changelog": false
  },
  "architecture_mode": "modular_two_repository_system",
  "repository_creation_policy": {
    "description": "See config/core_modules.v1.json for the canonical split policy",
    "split_policy_file": "config/core_modules.v1.json"
  },
  "deployment_inventory": {
    "vercel_project_inventory_file": "config/vercel_projects.v1.json",
    "destructive_actions_require_owner_approval": true
  }
}
