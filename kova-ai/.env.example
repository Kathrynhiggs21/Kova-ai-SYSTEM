# Example environment variables for Kova AI System

# Database Configuration
POSTGRES_DB=kova
POSTGRES_USER=kova
POSTGRES_PASSWORD=kova_pass

# Connection string for the application's database
# Use 'localhost' when running locally; Docker uses the 'db' host by default.
DATABASE_URL=postgresql+asyncpg://kova:kova_pass@localhost:5432/kova

# Owner access to KOVA control-plane endpoints. Generate a long random value
# before starting the API and send it as the X-Kova-API-Key header. The sample
# is empty so copied configuration fails closed.
KOVA_OWNER_API_KEY=

# Comma-separated browser origins allowed to call the API.
# Never use * for a credentialed KOVA deployment.
KOVA_ALLOWED_ORIGINS=http://localhost:5173

# Multi-Repository Management
# GitHub Personal Access Token (required for multi-repo sync)
# Generate at: https://github.com/settings/tokens
# Scopes needed: repo, read:org
GITHUB_TOKEN=ghp_your_github_token_here

# Anthropic Claude API Key (required for AI integration)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# Required when the GitHub webhook endpoint is enabled.
# Generate a unique value and configure the same value in GitHub. It is empty
# by default so a copied template fails closed instead of using a known secret.
GITHUB_WEBHOOK_SECRET=
