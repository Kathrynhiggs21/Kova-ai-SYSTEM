{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kovaos.com/schemas/agent-ledger-entry.schema.json",
  "title": "KOVA Agent Ledger Entry",
  "type": "object",
  "required": ["task_id", "agent_provider", "status", "started_at"],
  "properties": {
    "task_id": {"type": "string"},
    "parent_task_id": {"type": ["string", "null"]},
    "originating_surface": {"type": ["string", "null"]},
    "module": {"type": ["string", "null"]},
    "project": {"type": ["string", "null"]},
    "topic_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "agent_provider": {"type": "string"},
    "agent_name": {"type": ["string", "null"]},
    "model_or_version": {"type": ["string", "null"]},
    "account_scope": {"type": ["string", "null"]},
    "connection_id": {"type": ["string", "null"]},
    "capabilities_used": {"type": "array", "items": {"type": "string"}},
    "permissions_used": {"type": "array", "items": {"type": "string"}},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "input_context_refs": {"type": "array", "items": {"type": "string"}},
    "output_summary": {"type": ["string", "null"]},
    "artifact_refs": {"type": "array", "items": {"type": "string"}},
    "decisions": {"type": "array", "items": {"type": "string"}},
    "actions": {"type": "array", "items": {"type": "string"}},
    "approval_state": {"enum": ["not_required", "pending", "approved", "declined", "unknown"]},
    "validation_state": {"enum": ["pending", "passed", "failed", "not_run"]},
    "status": {"enum": ["queued", "running", "completed", "failed", "cancelled"]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "supersedes": {"type": "array", "items": {"type": "string"}},
    "superseded_by": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
